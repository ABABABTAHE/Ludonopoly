{
    "folders": [
        {
            "name": "Ludonopoly Root",
            "path": "."
        },
        {
            "name": "Monopoly Game",
            "path": "./ASH2225025M/Monopoly abtahe"
        },
        {
            "name": "Snake & Ladder Game",
            "path": "./ASH2225025M/Snake & Ladder"
        }
    ],
    "settings": {
        "java.configuration.updateBuildConfiguration": "automatic",
        "java.project.sourcePaths": [
            "ASH2225025M/Monopoly abtahe/src/main/java",
            "ASH2225025M/Snake & Ladder"
        ],
        "java.project.outputPath": "ASH2225025M/Monopoly abtahe/target/classes",
        "java.compile.nullAnalysis.mode": "automatic",
        "java.saveActions.organizeImports": true,
        "java.format.settings.profile": "GoogleStyle",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.organizeImports": true
        },
        "files.exclude": {
            "**/target": true,
            "**/.classpath": true,
            "**/.project": true,
            "**/.settings": true,
            "**/.factorypath": true,
            "**/*.class": false
        }
    },
    "extensions": {
        "recommendations": [
            "vscjava.vscode-java-pack",
            "vscjava.vscode-java-dependency",
            "vscjava.vscode-java-test",
            "vscjava.vscode-maven",
            "vscjava.vscode-java-debug",
            "redhat.java",
            "ms-vscode.vscode-json",
            "formulahendry.code-runner"
        ]
    }
}